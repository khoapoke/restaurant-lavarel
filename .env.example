APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Ho_Chi_Minh

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# VietQR (thông tin tài khoản nhận chuyển khoản)
VIETQR_BANK_BIN=970436
VIETQR_ACCOUNT_NO=1029384756
VIETQR_ACCOUNT_NAME="MOC DINING"
VIETQR_TEMPLATE=compact2
VIETQR_EXPIRES_MINUTES=15

# Webhook cổng thanh toán: chữ ký HMAC-SHA256 của raw body trong header X-Signature
PAYMENT_WEBHOOK_SECRET=
# Chỉ bật ở môi trường demo nội bộ khi chưa có secret; luôn tắt ở production
PAYMENT_WEBHOOK_ALLOW_UNSIGNED=false

# Mộc Live Dining (gọi món QR tại bàn, ADR-020)
# Link trong mã QR bàn: {FRONTEND_URL}/dine/{token}. Dùng IP LAN (vd http://192.168.1.20:5173) để quét bằng điện thoại.
FRONTEND_URL=http://localhost:5173
KITCHEN_SLA_WARNING_MINUTES=10
KITCHEN_SLA_LATE_MINUTES=20
DINE_CHECK_IN_EXPIRES_MINUTES=15
DINE_VISIT_READABLE_HOURS=6
DINE_SERVICE_REQUEST_COOLDOWN=30
# Lệnh php artisan dining:demo (luôn bị chặn ở production)
LIVE_DINING_DEMO_ENABLED=true
LIVE_DINING_DEMO_TABLE="Bàn L01"
DINE_JOIN_CODE_MAX_FAILURES=5

# Email + AI + support chat. Secrets belong only in your ignored local .env.
COMMUNICATIONS_ENABLED=true
COMMUNICATIONS_EMAIL_ENABLED=false
# Outside production, optionally redirect every email to your own test inbox.
COMMUNICATIONS_TEST_RECIPIENT=
RESERVATION_REMINDER_MINUTES=60
GEMINI_ENABLED=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
AI_DAILY_ACCOUNT_LIMIT=40
AI_DAILY_GLOBAL_LIMIT=500
GEMINI_MAX_OUTPUT_TOKENS=700
AI_STALE_AFTER_MINUTES=10
# Automatic email sending windows (minutes from notice creation; retries never extend them).
EMAIL_TTL_UPDATE_MINUTES=120
EMAIL_TTL_CLOSURE_MINUTES=1440
EMAIL_TTL_SUPPORT_REPLY_MINUTES=1440
EMAIL_TTL_FEEDBACK_MINUTES=2880
EMAIL_TTL_RECEIPT_MINUTES=10080
EMAIL_TTL_DEFAULT_MINUTES=1440
COMMUNICATIONS_DISPATCH_LEASE_MINUTES=10
COMMUNICATIONS_STALLED_QUEUE_MINUTES=2
SUPPORT_CUSTOMER_PER_MINUTE=12
SUPPORT_STAFF_PER_MINUTE=60
EMAIL_RETRY_PER_MINUTE=10
